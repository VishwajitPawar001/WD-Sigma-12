<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h3>Edit your chat: <%= chat._id %></h3>
    
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <p>This chat was sent from <b><%= chat.from %></b> to <i><%= chat.to %></i></p>
        <textarea name="msg" id="" rows="10" cols="50"> <%= chat.msg %></textarea> <br>
        <button>Edit</button>
    </form>
</body>
</html>